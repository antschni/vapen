# Public URL of your Vapen instance (used in invite links; Coolify sets SERVICE_URL_WEB_3000 automatically)
PUBLIC_BASE_URL=https://vapen.example.com

# Domain for Caddy TLS (profile caddy)
VAPEN_DOMAIN=vapen.example.com

# Postgres password (Coolify auto-generates SERVICE_PASSWORD_64_POSTGRES when referenced in compose)
# SERVICE_PASSWORD_64_POSTGRES=

# Generate with: go run ./cmd/vapen-api keygen  (from api/)
JWT_ED25519_PRIVATE_KEY=

# Comma-separated CIDRs that may set X-Forwarded-For (Caddy + web BFF on Docker network)
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Web / Android App Links
ANDROID_PACKAGE_NAME=dev.vapen.app
ANDROID_CERT_SHA256_FINGERPRINTS=
