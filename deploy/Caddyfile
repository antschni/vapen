{$VAPEN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@sse path /api/*/groups/*/live
	handle @sse {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
